{
  "name": "mail-code-copy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that copies login codes from a Fastmail inbox.",
  "scripts": {
    "check": "find src scripts -name '*.js' -o -name '*.mjs' | xargs -n1 node --check",
    "test": "npm run build && node --test --test-timeout=60000",
    "build": "./scripts/build.sh",
    "lint": "npm run build && web-ext lint --source-dir dist/firefox"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.65.0",
    "selenium-webdriver": "4.52.0",
    "web-ext": "10.8.0"
  }
}
