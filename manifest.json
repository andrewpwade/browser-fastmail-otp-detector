{
  "manifest_version": 3,
  "name": "Mail Code Copy",
  "version": "0.1.0",
  "description": "Catches login and verification codes in your Fastmail inbox and lets you copy them in one click. Not affiliated with Fastmail.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.fastmail.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mail Code Copy",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "short_name": "Mail Code Copy",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116"
}